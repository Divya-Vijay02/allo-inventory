generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())

  stock        Stock[]
  Reservation  Reservation[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  sku         String   @unique
  createdAt   DateTime @default(now())

  stock       Stock[]
  Reservation Reservation[]
}

model Stock {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  total       Int       // total physical units
  reserved    Int       @default(0) // currently held by pending reservations

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model Reservation {
  id          String            @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())

  // For idempotency bonus
  idempotencyKey String? @unique

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
}

// For idempotency key caching (bonus feature)
model IdempotencyRecord {
  key        String   @id
  statusCode Int
  body       Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
